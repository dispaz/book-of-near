{
  "name": "book-of-near",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright install chromium && playwright test",
    "check-secrets": "node scripts/check-secrets.mjs --staged",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name book-of-near",
    "prepare": "git config core.hooksPath .githooks || true",
    "new-lesson": "node scripts/new-lesson.mjs",
    "test:testnet": "TESTNET=1 vitest run src/chain/testnet/testnet.test.ts",
    "test:testnet:lessons": "TESTNET=1 vitest run scripts/verify-lessons.testnet.test.ts",
    "build:counter": "node scripts/build-counter.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:badge": "node scripts/build-badge.mjs",
    "test:badge": "npm run build:badge && cargo test --manifest-path contracts/badge/sandbox-tests/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@hot-labs/near-connect": "0.12.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "near-kit": "0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "^0.187.0",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "binaryen": "^123.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wabt": "1.0.39"
  }
}
