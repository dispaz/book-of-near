# Copy to .env.local for the app, and to worker/.dev.vars for the Worker. Never commit real values.
# App (public, safe in the browser)
VITE_CHAIN_MODE=demo            # demo | testnet
VITE_WORKER_URL=http://localhost:8787
VITE_BADGE_CONTRACT_ID=                # testnet badge contract; empty = badges.bon-badges-mwe57oab.testnet
# Worker secrets (set with `wrangler secret put`, never in the repo)
FAUCET_ACCOUNT_ID=
FAUCET_PRIVATE_KEY=
CLAIM_SIGNING_KEY=                     # badge claim key, ed25519:<base58> (docs/badge-contract.md)
ONECLICK_API_KEY=
VITE_RETURN_ACCOUNT_ID=                # testnet account that lesson transfers go back to (the faucet account)
