# Copy to .env.local for the app, and to worker/.dev.vars for the Worker. Never commit real values.
# App (public, safe in the browser)
VITE_CHAIN_MODE=demo            # demo | testnet
VITE_WORKER_URL=http://localhost:8787
# Worker secrets (set with `wrangler secret put`, never in the repo)
FAUCET_ACCOUNT_ID=
FAUCET_PRIVATE_KEY=
CLAIM_SIGNER_PRIVATE_KEY=
ONECLICK_API_KEY=
